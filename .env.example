# Network (amoy or mainnet)
NETWORK=amoy

# Alchemy RPC (WebSocket for real-time)
ALCHEMY_AMOY_WSS=wss://polygon-amoy.g.alchemy.com/v2/your_amoy_key_here
ALCHEMY_MAINNET_WSS=wss://polygon-mainnet.g.alchemy.com/v2/your_mainnet_key_here

# Wallet (TEST WALLET ONLY for now)
PRIVATE_KEY=your_test_wallet_private_key_here

# Vault (add later when deployed)
VAULT_ADDRESS=0xYourVaultAddressHere

# Telegram
TELEGRAM_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_chat_id

# Thresholds 
WHALE_TRANSFER_THRESHOLD_USD=100000  # $100K+
VOLUME_SPIKE_PERCENT=50